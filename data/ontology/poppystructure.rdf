    <!-- http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#treatsDisease -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#treatsDisease">
