        <rdfs:comment>Dosage information for a therapy</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasIUPACName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasIUPACName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#ChemicalConcept"/>
        <rdfs:comment>A compound&apos;s IUPAC name</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasMolecularFormula -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasMolecularFormula">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#ChemicalConcept"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasMolecularWeight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasMolecularWeight">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#ChemicalConcept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The molecular weight of a compound</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasSMILES -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasSMILES">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#ChemicalConcept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The SMILES representation of a compound&apos;s structure</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasSource -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasSource">
