    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasTherapeuticClass -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/orestah/ontologies/2024/9/phytotherapies#hasTherapeuticClass">
